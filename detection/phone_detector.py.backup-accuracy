from ultralytics import YOLO
from resource_paths import resource_path


class PhoneDetector:
    """
    Fast phone detector.

    YOLO is intentionally run at a smaller image size because
    phone detection does not need the full 640x480 frame resolution.
    """

    PHONE_CLASS_ID = 67

    def __init__(self, model_path=None, confidence=0.25):
        model_file = (
            resource_path("yolo11n.pt")
            if model_path is None
            else model_path
        )

        self.model = YOLO(str(model_file))
        self.confidence = confidence

    def detect(self, frame):
        """
        Returns True when a cell phone is detected.
        """

        results = self.model.predict(
            source=frame,
            conf=self.confidence,
            imgsz=320,
            device="cpu",
            verbose=False,
        )

        for result in results:
            if result.boxes is None:
                continue

            for box in result.boxes:
                class_id = int(box.cls[0])

                if class_id == self.PHONE_CLASS_ID:
                    confidence = float(box.conf[0])

                    if confidence >= self.confidence:
                        return True

        return False

import time
import math
import yaml
import cv2
import pygame

from detection.face_detector import FaceDetector
from detection.phone_detector import PhoneDetector
from resource_paths import resource_path
from audio.warning_controller import WarningController
from startup_check import validate_resources


# ============================================================
# CONFIGURATION
# ============================================================

EYES_CLOSED_DELAY = 2.0
NO_FACE_DELAY = 2.0

EYE_CLOSED_THRESHOLD = 0.20

UTH_JAA_SOUND = str(resource_path("assets/sounds/uth_jaa.mp3"))
DEKH_DEKH_SOUND = str(resource_path("assets/sounds/arvind_dekh.mp3"))
PHONE_WARNING_SOUND = str(resource_path("assets/sounds/phone_warning.mp3"))


# ============================================================
# LOAD CONFIG
# ============================================================

validate_resources()
CONFIG_PATH = resource_path("config.yaml")

if not CONFIG_PATH.is_file():
    raise FileNotFoundError(
        f"Could not find config.yaml at:\n{CONFIG_PATH}"
    )

with open(CONFIG_PATH, "r", encoding="utf-8") as f:
    config = yaml.safe_load(f)


# ============================================================
# AUDIO
# ============================================================

warning_controller = WarningController(
    sounds_dir=resource_path("assets/sounds")
)

print("Warning audio controller initialized.")


# ============================================================
# CAMERA
# ============================================================

cam_cfg = config["camera"]

cap = cv2.VideoCapture(cam_cfg["index"])

cap.set(
    cv2.CAP_PROP_FRAME_WIDTH,
    cam_cfg["width"]
)

cap.set(
    cv2.CAP_PROP_FRAME_HEIGHT,
    cam_cfg["height"]
)

cap.set(
    cv2.CAP_PROP_FPS,
    cam_cfg["fps"]
)

if not cap.isOpened():
    raise RuntimeError(
        f"Could not open camera index {cam_cfg['index']}"
    )


# ============================================================
# FACE DETECTOR
# ============================================================

face_cfg = config["face_detection"]

try:
    detector = FaceDetector(
        model_path=str(resource_path(face_cfg["model_path"])),
        num_faces=face_cfg["num_faces"],
        min_detection_confidence=face_cfg["min_face_detection_confidence"],
        min_tracking_confidence=face_cfg["min_tracking_confidence"],
    )
except Exception as error:
    raise RuntimeError(
        "MediaPipe FaceLandmarker could not be initialized. "
        "Run `python -m startup_check --probe-face-landmarker` for an isolated diagnostic. "
        f"Details: {error}"
    ) from error


# ============================================================
# PHONE DETECTOR
# ============================================================

try:
    phone_detector = PhoneDetector(
        model_path=str(resource_path("yolo11n.pt")),
        confidence=0.25,
    )
    print("Phone detector initialized.")
except Exception as error:
    raise RuntimeError(
        f"YOLO phone detector could not be initialized: {error}"
    ) from error


# ============================================================
# EYE LANDMARKS
# ============================================================

LEFT_EYE = [
    33,
    160,
    158,
    133,
    153,
    144
]

RIGHT_EYE = [
    362,
    385,
    387,
    263,
    373,
    380
]


# ============================================================
# EAR CALCULATION
# ============================================================

def distance(p1, p2):
    return math.sqrt(
        (p1[0] - p2[0]) ** 2 +
        (p1[1] - p2[1]) ** 2
    )


def eye_aspect_ratio(
    landmarks,
    eye_indices,
    width,
    height
):
    points = []

    for index in eye_indices:
        lm = landmarks[index]

        points.append(
            (
                lm.x * width,
                lm.y * height
            )
        )

    vertical_1 = distance(
        points[1],
        points[5]
    )

    vertical_2 = distance(
        points[2],
        points[4]
    )

    horizontal = distance(
        points[0],
        points[3]
    )

    if horizontal == 0:
        return 0.0

    ear = (
        vertical_1 +
        vertical_2
    ) / (2.0 * horizontal)

    return ear


# ============================================================
# STATE VARIABLES
# ============================================================

no_face_since = None
eyes_closed_since = None

no_face_alert_played = False
eyes_closed_alert_played = False
phone_alert_played = False

prev_time = time.time()


# ============================================================
# STARTUP
# ============================================================

print()
print("==========================================")
print("        SMART STUDY MONITOR")
print("==========================================")
print()
print("Face missing  -> dekh-dekh sound")
print("Eyes closed   -> uth-jaa sound")
print()
print(f"Face delay: {NO_FACE_DELAY} seconds")
print(f"Eyes delay: {EYES_CLOSED_DELAY} seconds")
print()
print("Press Q to quit.")
print()


# ============================================================
# MAIN LOOP
# ============================================================

try:

    while True:

        ret, frame = cap.read()

        if not ret:
            print("Failed to read frame.")
            break

        h, w = frame.shape[:2]


        # ====================================================
        # DETECT PHONE
        # ====================================================

        try:
            phone_found = phone_detector.detect(frame)
        except Exception as error:
            print(f"[PHONE DETECTOR ERROR] {error}")
            phone_found = False


        # ====================================================
        # PHONE STATUS
        # ====================================================

        if phone_found:
            cv2.putText(
                frame,
                "PHONE DETECTED",
                (10, 120),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.75,
                (0, 0, 255),
                2,
            )
        else:
            cv2.putText(
                frame,
                "NO PHONE",
                (10, 120),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (0, 255, 0),
                2,
            )


        # ====================================================
        # PHONE WARNING
        # ====================================================

        if phone_found:
            print("PHONE DETECTED")

            warning_controller.set_condition(
                "phone_detected",
                True,
                "phone_warning.mp3",
            )

            phone_alert_played = True

        else:
            warning_controller.set_condition(
                "phone_detected",
                False,
                "phone_warning.mp3",
            )

            phone_alert_played = False


        # ====================================================
        # DETECT FACE
        # ====================================================

        result = detector.detect(frame)

        face_found = bool(result.face_landmarks)


        # ====================================================
        # FACE FOUND
        # ====================================================

        if face_found:

            landmarks = result.face_landmarks[0]


            # ------------------------------------------------
            # RESET FACE-MISSING STATE
            # ------------------------------------------------

            no_face_since = None
            no_face_alert_played = False

            warning_controller.set_condition(
                "face_missing",
                False,
                "arvind_dekh.mp3",
            )


            # ------------------------------------------------
            # CALCULATE EAR
            # ------------------------------------------------

            left_ear = eye_aspect_ratio(
                landmarks,
                LEFT_EYE,
                w,
                h
            )

            right_ear = eye_aspect_ratio(
                landmarks,
                RIGHT_EYE,
                w,
                h
            )

            average_ear = (
                left_ear +
                right_ear
            ) / 2.0


            # ------------------------------------------------
            # DETERMINE EYE STATE
            # ------------------------------------------------

            eyes_closed = (
                average_ear <
                EYE_CLOSED_THRESHOLD
            )


            # =================================================
            # EYES CLOSED
            # =================================================

            if eyes_closed:

                if eyes_closed_since is None:
                    eyes_closed_since = time.time()

                closed_duration = (
                    time.time() -
                    eyes_closed_since
                )


                # ---------------------------------------------
                # PLAY UTH JAA
                # ---------------------------------------------

                if (
                    closed_duration >=
                    EYES_CLOSED_DELAY
                    and
                    not eyes_closed_alert_played
                ):

                    print(
                        "Eyes closed -> "
                        "playing UTH JAA"
                    )

                    warning_controller.set_condition(
                        "eyes_closed",
                        True,
                        "uth_jaa.mp3",
                    )

                    eyes_closed_alert_played = True


                eye_status = "EYES CLOSED"
                eye_color = (0, 0, 255)


            # =================================================
            # EYES OPEN
            # =================================================

            else:

                eyes_closed_since = None
                eyes_closed_alert_played = False

                warning_controller.set_condition(
                    "eyes_closed",
                    False,
                    "uth_jaa.mp3",
                )

                eye_status = "EYES OPEN"
                eye_color = (0, 255, 0)


            # =================================================
            # DRAW FACE BOX / LANDMARKS
            # =================================================

            if config["ui"]["show_landmarks"]:

                xs = [
                    lm.x * w
                    for lm in landmarks
                ]

                ys = [
                    lm.y * h
                    for lm in landmarks
                ]

                x_min = int(min(xs))
                x_max = int(max(xs))

                y_min = int(min(ys))
                y_max = int(max(ys))


                cv2.rectangle(
                    frame,
                    (x_min, y_min),
                    (x_max, y_max),
                    (0, 255, 0),
                    2
                )


                # Draw eye landmarks

                for index in LEFT_EYE + RIGHT_EYE:

                    lm = landmarks[index]

                    x = int(lm.x * w)
                    y = int(lm.y * h)

                    cv2.circle(
                        frame,
                        (x, y),
                        3,
                        (255, 255, 0),
                        -1
                    )


            # =================================================
            # STATUS
            # =================================================

            cv2.putText(
                frame,
                "STUDENT DETECTED",
                (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.75,
                (0, 255, 0),
                2
            )

            cv2.putText(
                frame,
                eye_status,
                (10, 60),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.75,
                eye_color,
                2
            )

            cv2.putText(
                frame,
                f"EAR: {average_ear:.3f}",
                (10, 90),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (255, 255, 255),
                2
            )


        # ====================================================
        # FACE NOT FOUND
        # ====================================================

        else:

            # ------------------------------------------------
            # RESET EYE STATE
            # ------------------------------------------------

            eyes_closed_since = None
            eyes_closed_alert_played = False


            # ------------------------------------------------
            # START FACE-MISSING TIMER
            # ------------------------------------------------

            if no_face_since is None:
                no_face_since = time.time()

            no_face_duration = (
                time.time() -
                no_face_since
            )


            # ------------------------------------------------
            # PLAY DEKH-DEKH
            # ------------------------------------------------

            if (
                no_face_duration >=
                NO_FACE_DELAY
                and
                not no_face_alert_played
            ):

                print(
                    "Student not detected -> "
                    "playing DEKH DEKH"
                )

                warning_controller.set_condition(
                    "face_missing",
                    True,
                    "arvind_dekh.mp3",
                )

                no_face_alert_played = True


            # ------------------------------------------------
            # STATUS
            # ------------------------------------------------

            cv2.putText(
                frame,
                "STUDENT NOT DETECTED",
                (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.75,
                (0, 0, 255),
                2
            )

            cv2.putText(
                frame,
                f"Missing: {no_face_duration:.1f}s",
                (10, 60),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (255, 255, 255),
                2
            )


        # ====================================================
        # FPS
        # ====================================================

        now = time.time()

        fps = (
            1.0 / (now - prev_time)
            if now > prev_time
            else 0.0
        )

        prev_time = now


        cv2.putText(
            frame,
            f"FPS: {fps:.1f}",
            (10, h - 20),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            (255, 255, 255),
            2
        )


        # ====================================================
        # SHOW CAMERA
        # ====================================================

        cv2.imshow(
            "Padh Le",
            frame
        )


        # ====================================================
        # QUIT
        # ====================================================

        if cv2.waitKey(1) & 0xFF == ord("q"):
            break


# ============================================================
# CLEANUP
# ============================================================

finally:

    cap.release()

    cv2.destroyAllWindows()

    try:
        warning_controller.close()
    except Exception:
        pass

    try:
        detector.close()
    except Exception:
        pass

    print()
    print("Padh Le stopped.")
